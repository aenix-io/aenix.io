{{- /*
  Sitemap override — excludes pages that render <meta name="robots" content="noindex">.

  Hugo's built-in sitemap template lists every renderable page and knows nothing
  about the robots meta tag, so noindex pages were being submitted to Google
  (including /404.html). Submitting a noindex URL is a Search Console error:
  Google fetches it, finds noindex, and reports "Submitted URL marked noindex".

  The rules are in layouts/partials/seo/noindex.html (see below).
*/ -}}
{{- /*
  The rules live in layouts/partials/seo/noindex.html, shared with the robots
  meta in seo/head.html. Russian pages stay out of the sitemap, except the
  certification programme (/certification/, Russian-language, html lang="ru"),
  which is a product and is meant to be found.
*/ -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- range .Data.Pages }}
    {{- $p := . -}}
    {{- $noindex := (partial "seo/noindex.html" $p).noindex -}}
    {{- if and $p.Permalink (not $noindex) }}
  <url>
    <loc>{{ $p.Permalink }}</loc>
    {{- if not $p.Lastmod.IsZero }}
    <lastmod>{{ safeHTML ($p.Lastmod.Format "2006-01-02T15:04:05-07:00") }}</lastmod>
    {{- end }}
    {{- with $p.Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>
    {{- end }}
    {{- if ge $p.Sitemap.Priority 0.0 }}
    <priority>{{ $p.Sitemap.Priority }}</priority>
    {{- end }}
  </url>
    {{- end }}
  {{- end }}
  {{- /* Indexable hand-written pages under /static/ that Hugo does not know
         about. Keep in sync with the files: /con/speakers.html is a
         handbook for accepted speakers and carries its own noindex. */ -}}
  {{- if eq .Site.Language.Lang "en" }}
  {{- range slice "con/" "con/cfp.html" }}
  <url>
    <loc>{{ . | absURL }}</loc>
  </url>
  {{- end }}
  {{- end }}
</urlset>
