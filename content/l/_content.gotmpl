{{/*
  Short links: one page per file in data/links/, published at /l/<slug>/.

  Files are written by scripts/apply-links.mjs from the changesets the editor
  submits. Entries whose status is not "active" stay in the registry as history
  but produce no page, so a disabled link 404s instead of redirecting.

  _inbox holds changesets that have not been applied yet — it is a directory, so
  Hugo surfaces it as a nested map here. It must never generate pages.
*/}}
{{ range $slug, $link := site.Data.links }}
  {{ if ne $slug "_inbox" }}
    {{ $target := $link.target_url }}
    {{ $status := default "active" $link.status }}

    {{ if and $target (eq $status "active") }}
      {{ $.AddPage (dict
        "path"    $slug
        "title"   (printf "Redirecting to %s" $target)
        "kind"    "page"
        "layout"  "redirect"
        "build"   (dict "render" "always" "list" "never" "publishResources" false)
        "sitemap" (dict "disable" true)
        "params"  (dict
          "target"     $target
          "slug"       $slug
          "created_at" (default "" $link.created_at)
          "created_by" (default "" $link.created_by)
          "note"       (default "" $link.note)
        )
        "content" (dict "mediaType" "text/html" "value" "")
      ) }}
    {{ end }}
  {{ end }}
{{ end }}
